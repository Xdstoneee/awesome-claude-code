# PALANTIR — API Keys & Credentials
# Copy this to .env and fill in what you have.
# Sources without keys still work (free tier / public APIs).

# ── ADS-B Aircraft (OpenSky Network) ─────────────────────────────
# Free account → 4,000 API credits/day vs 100 unauthenticated
# Register: https://opensky-network.org/index.php?option=com_users&task=registration.register
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── AIS Maritime (aisstream.io) ───────────────────────────────────
# Free API key — real-time global AIS WebSocket stream
# Register: https://aisstream.io
AISSTREAM_API_KEY=

# ── NASA FIRMS — Active Fire/Hotspot Detections ───────────────────
# Free with NASA Earthdata account
# 1. Register: https://www.earthdata.nasa.gov/
# 2. Get MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ── Satellite Orbit Propagation (optional) ────────────────────────
# No key needed — just install sgp4:
#   pip install sgp4
# Then uncomment in palantir/requirements.txt

# ── Paid / Higher-tier optional sources ───────────────────────────
# TomTom Traffic API (free 2,500 req/day)
# https://developer.tomtom.com/
TOMTOM_API_KEY=

# HERE Traffic API (free 250,000 req/month)
# https://developer.here.com/
HERE_API_KEY=
